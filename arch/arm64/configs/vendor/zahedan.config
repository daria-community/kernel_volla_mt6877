# Battey / Charger
CONFIG_CHARGER_SC8551=y
CONFIG_MTK_CW2217_SUPPORT=y

# Camera
CONFIG_CUSTOM_KERNEL_IMGSENSOR="ov50a40_mipi_raw ov16a1q_mipi_raw gc02m1macro_mipi_raw gc08a3wide_mipi_raw"
CONFIG_MTK_LENS_DW9781CAF_SUPPORT=y

# Display
CONFIG_CUSTOM_KERNEL_LCM="panel-boe-rm692e5-cmd"
CONFIG_DRM_PANEL_BOE_RM692E5_CMD=y
CONFIG_LCM_HEIGHT="2400"

# DTBO
CONFIG_BUILD_ARM64_DTB_OVERLAY_IMAGE_NAMES="mediatek/zahedan"

# NFC
CONFIG_NFC_CHIP_SUPPORT=y

# Project
CONFIG_ARCH_MTK_PROJECT="zahedan"
CONFIG_DARIA_PRODUCT_ZAHEDAN=y

# Touch
CONFIG_TOUCHSCREEN_GOODIX_BRL=y

# TEE
CONFIG_MICROTRUST_TEE_SUPPORT=y
CONFIG_MTK_SVP_ON_MTEE_SUPPORT=y
CONFIG_MTK_SEC_VIDEO_PATH_SUPPORT=y
