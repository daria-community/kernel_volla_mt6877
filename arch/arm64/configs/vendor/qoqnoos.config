# Battery / Charger
CONFIG_CHARGER_UPM6722=y
CONFIG_SM5602_SUPPORT=y
CONFIG_MTK_PUMP_EXPRESS_PLUS_20_SUPPORT=y

# Camera
CONFIG_CUSTOM_KERNEL_IMGSENSOR="ov50e40_mipi_raw ov16a1q_mipi_raw ov08d10wide_mipi_raw gc02m1macro_mipi_raw ov50a40_mipi_raw"
CONFIG_MTK_LENS_PD9402A_SUPPORT=y

# Display
CONFIG_CUSTOM_KERNEL_LCM="panel-ml-vtdr6126-vdo"
CONFIG_DRM_PANEL_ML_VTDR6126_VDO=y
CONFIG_LCM_HEIGHT="2436"

# DTBO
CONFIG_BUILD_ARM64_DTB_OVERLAY_IMAGE_NAMES="mediatek/qoqnoos"

# NFC
CONFIG_NFC=y
CONFIG_SEC_NFC_IF_I2C=y
CONFIG_SEC_NFC_PRODUCT_N5=y
CONFIG_SEC_NFC=y

# Project
CONFIG_ARCH_MTK_PROJECT="qoqnoos"
CONFIG_DARIA_PRODUCT_QOQNOOS=y

# Security
CONFIG_MTK_SECURITY_SW_SUPPORT=y
CONFIG_PRIZE_CTS=y

# Sensors
CONFIG_CUSTOM_KERNEL_SAR=y

# Touch
CONFIG_TOUCHSCREEN_FTS_FT3519=y

# TEE
CONFIG_TRUSTONIC_TEE_SUPPORT=y
CONFIG_MTK_TEE_GP_SUPPORT=y
